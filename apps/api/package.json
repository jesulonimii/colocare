{
	"name": "@colocare/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc -p tsconfig.json",
		"check": "tsc --noEmit",
		"migrate": "kysely migrate:latest",
		"db:codegen": "kysely-codegen --dialect postgres --camel-case --out-file src/database/db.types.ts"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/jwt": "^10.2.0",
		"argon2": "^0.44.0",
		"bullmq": "^6.2.0",
		"fastify": "^5.10.0",
		"ioredis": "^6.0.0",
		"kysely": "^0.29.3",
		"pg": "^8.16.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.12.3",
		"@types/pg": "^8.15.5",
		"kysely-codegen": "^0.20.0",
		"kysely-ctl": "^0.21.0",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.23.1",
		"typescript": "~6.0.2"
	}
}
