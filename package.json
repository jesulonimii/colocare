{
	"name": "colocare",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@11.1.1",
	"scripts": {
		"dev": "pnpm --parallel --filter @colocare/api --filter @colocare/web dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "pnpm typecheck && pnpm lint",
		"start": "pnpm --filter @colocare/api start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3"
	}
}
